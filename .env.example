# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Only public (browser-safe) values are used by the website.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public address of this website (used in password-reset emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Maximum characters per clue (default 50, hard database limit 200).
NEXT_PUBLIC_CLUE_MAX_LENGTH=50
# Time zone for dates shown in the admin site (optional, default Australia/Brisbane)
NEXT_PUBLIC_ADMIN_TIME_ZONE=Australia/Brisbane

# --- Scripts only (never used by the website, never exposed to browsers) ---
# Needed by `npm run admin:create` to create the first administrator.
SUPABASE_SERVICE_ROLE_KEY=
